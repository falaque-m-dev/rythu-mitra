# Rythu Mitra API configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public origins allowed to call the API directly (comma separated).
# The Next.js app proxies /api/* server-side, so this is only needed for direct access.
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Google AI Studio keys (optional). Add one or more keys from different
# projects; quota is shared per project, not per key.
GEMINI_API_KEY=
GEMINI_API_KEY_ONE=
GEMINI_API_KEY_TWO=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Natural voice (Gemini TTS). Requires one of the Gemini keys above.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
TTS_MAX_CHARS=1200

# Limits
MAX_BODY_BYTES=12582912
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=10
UPSTREAM_TIMEOUT_MS=8000
AI_TIMEOUT_MS=45000

# Set to 1 only when running behind a trusted reverse proxy.
TRUST_PROXY=0
